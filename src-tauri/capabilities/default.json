{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:3080"]
  },
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "allow-save-image",
    "allow-save-image-data"
  ]
}
